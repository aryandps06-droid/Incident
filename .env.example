# ==============================================================================
# EchoAid X — AI Incident Commander (Environment Configuration Template)
# Copy this file to .env and fill in your credentials. Never commit real keys.
# ==============================================================================

# --- Frontend Configuration ---
# API Base URL for backend server (e.g. https://incident-ih39.onrender.com in prod, or http://localhost:8000 in dev)
VITE_API_URL=https://incident-ih39.onrender.com
VITE_API_BASE_URL=https://incident-ih39.onrender.com
VITE_API_BASE=https://incident-ih39.onrender.com

# Agora RTC App ID (Public WebRTC Client ID)
VITE_AGORA_APP_ID=your_agora_app_id_here
VITE_AGORA_CHANNEL=echoaid-room

# --- Backend Configuration ---
# Port for FastAPI server
PORT=8000

# Backend CORS Allowed Frontend Origin (e.g., https://your-app.onrender.com)
FRONTEND_ORIGIN=http://localhost:5173
ALLOW_ALL_CORS=true

# Agora RTC & Conversational AI Agent Credentials (Server-Side Only — Kept Secret)
AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERTIFICATE=your_agora_app_certificate_here
AGORA_CUSTOMER_ID=your_agora_customer_id_here
AGORA_CUSTOMER_SECRET=your_agora_customer_secret_here
AGORA_PIPELINE_ID=your_agora_conversational_ai_pipeline_id_here

# NVIDIA NIM / LLM Intelligence Engine (Server-Side Only)
NVIDIA_API_KEY=your_nvidia_nim_api_key_here
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
